generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 생성된 블로그 글 기록
model BlogPost {
  id            Int      @id @default(autoincrement())
  sourceUrl     String   @db.Text // 참고한 블로그 링크
  mainKeyword   String   @db.VarChar(100) // 메인 키워드
  regionKeyword String   @db.VarChar(100) // 지역 키워드
  title         String   @db.VarChar(255) // 생성된 제목
  content       String   @db.LongText // 생성된 HTML 콘텐츠
  tistoryPostId String?  @db.VarChar(100) // 티스토리 발행 후 포스트 ID
  durationMs    Int?     // 발행 소요시간 (밀리초)
  previewDurationMs Int? // 미리보기(AI 생성) 소요시간 (밀리초)
  status        String   @default("created") @db.VarChar(50) // created, published, failed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// 프롬프트 템플릿 관리
model PromptTemplate {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  content   String   @db.LongText
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 카카오 로그인 자격증명 (암호화 저장)
model KakaoCredential {
  id                Int      @id @default(autoincrement())
  userEmail         String   @unique @db.VarChar(255)
  encryptedPassword String   @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// 티스토리 로그인 쿠키 저장 (유저별 분리)
model TistoryCookie {
  id        Int      @id @default(autoincrement())
  userEmail String   @unique @db.VarChar(255) // 카카오 이메일 (고유키)
  cookies   String   @db.LongText // JSON 형식 쿠키 데이터
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 예약 발행 글
model ScheduledPost {
  id           Int      @id @default(autoincrement())
  title        String   @db.VarChar(255)
  content      String   @db.LongText
  tag          String?  @db.VarChar(255)
  userEmail    String   @db.VarChar(255)
  scheduledAt  DateTime
  status       String   @default("scheduled") @db.VarChar(50) // scheduled, publishing, published, failed, cancelled
  errorMessage String?  @db.Text
  tistoryUrl   String?  @db.VarChar(500)
  blogPostId   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, scheduledAt])
}
